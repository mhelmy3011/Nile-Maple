+.person-avatar{width:56px;height:56px;border-radius:50%;background:var(--pine-900);color:var(--amber-400);font-weight:800;font-size:1.5rem;display:inline-flex;align-items:center;justify-content:center}
+.person-role{color:var(--green-700);font-weight:800;font-size:.875rem}
+.person p{margin:0;color:var(--text-muted);font-size:.9375rem}
+@media (min-width:768px){.people-grid{grid-template-columns:1fr 1fr}}
+.vision{margin:0;background:var(--green-50);border-inline-start:4px solid var(--green-500);border-radius:var(--r-md);padding:var(--sp-6)}
+.vision h2{font-size:1.375rem}
+.vision ul{margin:0;padding-inline-start:20px;color:var(--text-muted);display:grid;gap:6px}
+
+/* tabs (featured) */
+.tabs{display:flex;gap:var(--sp-2);overflow-x:auto;scrollbar-width:none;margin-block-end:var(--sp-5);padding-block:2px}
+.tabs::-webkit-scrollbar{display:none}
+.tab{flex:none;min-height:44px;padding-inline:var(--sp-5);border-radius:var(--r-pill);border:1.5px solid var(--border-strong);background:var(--surface);font:inherit;font-weight:800;font-size:.875rem;color:var(--text);cursor:pointer}
+.tab.is-active{background:var(--signal);border-color:var(--signal);color:var(--signal-text)}
+.tab-panel[hidden]{display:none}
+.tab-all{display:inline-flex;align-items:center;gap:6px;margin-block-start:var(--sp-4);font-weight:800;color:var(--green-700);text-decoration:none}
+
+/* season band */
+.season-inner{display:grid;gap:var(--sp-4);align-items:center}
+.season-icon{width:52px;height:52px;border-radius:var(--r-md);background:var(--amber-400);color:var(--amber-950);display:inline-flex;align-items:center;justify-content:center}
+.season-inner h2{margin-bottom:4px}
+.season-inner p{margin:0;color:var(--n-800)}
+@media (min-width:768px){.season-inner{grid-template-columns:auto 1fr auto}}
+
+/* faq */
+.faq-list{display:grid;gap:var(--sp-3)}
+.faq-item{background:var(--surface);border:1px solid var(--border);border-radius:var(--r-md);overflow:hidden}
+.faq-item summary{display:flex;align-items:center;justify-content:space-between;gap:var(--sp-4);padding:var(--sp-4);cursor:pointer;font-weight:800;list-style:none;min-height:56px}
+.faq-item summary::-webkit-details-marker{display:none}
+.faq-item .plus{transition:transform .2s var(--ease);color:var(--green-700)}
+.faq-item[open] .plus{transform:rotate(45deg)}
+.faq-a{padding:0 var(--sp-4) var(--sp-4);color:var(--text-muted);font-size:.9375rem}
+.faq-a p{margin:0}
+.faq-group{margin:var(--sp-8) 0 var(--sp-4);font-size:1.125rem;color:var(--green-800)}
+.faq-search{width:100%;min-height:48px;margin-block-end:var(--sp-5)}
+.center-link{text-align:center;margin-block-start:var(--sp-6)}
+
+/* categories page */
+.cat-grid{display:grid;gap:var(--sp-4)}
+.cat-card{display:grid;background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);overflow:hidden;text-decoration:none;color:var(--text);box-shadow:var(--e1)}
+.cat-card:hover{box-shadow:var(--e2)}
+.cc-media{position:relative;aspect-ratio:16/10;background:var(--surface-2)}
+.cc-media picture,.cc-media img{position:absolute;inset:0}
+.cc-body{padding:var(--sp-5);display:grid;gap:8px;justify-items:start}
+.cc-body h2{font-size:1.375rem;margin:0}
+.cc-body p{margin:0;color:var(--text-muted)}
+@media (min-width:768px){.cat-grid{grid-template-columns:1fr 1fr}}
+.az-list{list-style:none;margin:0;padding:0;display:grid;gap:8px;grid-template-columns:1fr}
+.az-list a{color:var(--text);text-decoration:none;font-weight:700;font-size:.9375rem}
+.az-list a:hover{color:var(--green-700)}
+@media (min-width:640px){.az-list{grid-template-columns:1fr 1fr}}
+@media (min-width:1024px){.az-list{grid-template-columns:repeat(3,1fr)}}
+
+/* filter bar (category) */
+.filterbar{position:sticky;top:var(--header-h);z-index:50;background:var(--surface);border-block-end:1px solid var(--border);padding-block:var(--sp-2)}
+.filter-row{display:flex;gap:var(--sp-2);align-items:center}
+.filter-row input[type=search]{flex:1;min-height:44px;border:1.5px solid var(--border-strong);border-radius:var(--r-pill);padding-inline:var(--sp-4);font:inherit;background:var(--surface-2)}
+.filter-row select{min-height:44px;border:1.5px solid var(--border-strong);border-radius:var(--r-pill);padding-inline:var(--sp-3);font:inherit;font-weight:700;background:var(--surface)}
+.filter-count{font-size:.75rem;font-weight:800;color:var(--text-muted);white-space:nowrap}
+.loadmore-wrap{text-align:center;margin-block-start:var(--sp-8)}
+
+/* product detail */
+.pd-top{padding-block-start:var(--sp-4)}
+.pd-grid{display:grid;gap:var(--sp-6)}
+.pd-main{border-radius:var(--r-lg);overflow:hidden;background:var(--surface-2);position:relative;aspect-ratio:1}
+.pd-main picture,.pd-main img{position:absolute;inset:0}
+.pd-temp{display:flex;gap:8px;align-items:center;margin-block-start:var(--sp-3)}
+.temp-badge{background:var(--amber-100);color:var(--amber-950);font-weight:800;font-size:.875rem;border-radius:var(--r-pill);padding:4px 14px}
+.pd-info h1{margin-block:var(--sp-2)}
+.pd-sku{margin-block-end:var(--sp-3)}
+.pd-desc{font-size:1.0625rem}
+.pd-actions{display:grid;gap:var(--sp-3);margin-block-start:var(--sp-6)}
+@media (min-width:640px){.pd-actions{grid-template-columns:1fr 1fr}}
+@media (min-width:1024px){.pd-grid{grid-template-columns:5fr 6fr;gap:var(--sp-12)}.pd-main{position:sticky;top:calc(var(--header-h) + 20px)}}
+.spec-rows{margin:var(--sp-6) 0 0;display:grid;gap:0;border-block-start:1px solid var(--border)}
+.spec-row{display:grid;gap:4px;padding-block:var(--sp-4);border-block-end:1px solid var(--border)}
+.spec-row dt{display:flex;align-items:center;gap:8px;font-weight:800;font-size:.8125rem;text-transform:uppercase;letter-spacing:.06em;color:var(--green-700)}
+html[lang="ar"] .spec-row dt{text-transform:none;letter-spacing:0}
+.sr-icon{width:20px;height:20px;color:var(--green-600)}
+.sr-icon .i{width:20px;height:20px}
+.spec-row dd{margin:0;color:var(--text);font-size:.9375rem}
+@media (min-width:768px){.spec-row{grid-template-columns:200px 1fr;gap:var(--sp-6);align-items:start}}
+.rail{overflow:hidden}
+.rail-track{overflow-x:auto;scroll-snap-type:x mandatory;scrollbar-width:none;padding-block:4px}
+.rail-track::-webkit-scrollbar{display:none}
+.rail-item{flex:0 0 78%;scroll-snap-align:start;padding-inline-end:var(--sp-3)}
+@media (min-width:640px){.rail-item{flex:0 0 46%}}
+@media (min-width:1024px){.rail-item{flex:0 0 24%}}
+
+/* contact */
+.contact-grid{display:grid;gap:var(--sp-8)}
+.contact-cards{display:grid;gap:var(--sp-3);align-content:start}
+.contact-card{display:grid;grid-template-columns:auto 1fr;gap:var(--sp-4);align-items:center;background:var(--surface-2);border:1px solid var(--border);border-radius:var(--r-md);padding:var(--sp-4);text-decoration:none;color:var(--text);min-height:64px}
+.contact-card:hover{border-color:var(--green-600)}
+.cc-icon{width:44px;height:44px;border-radius:var(--r-md);background:var(--green-100);color:var(--green-800);display:inline-flex;align-items:center;justify-content:center}
+.contact-card strong{display:block;font-size:.8125rem;color:var(--text-muted)}
+.contact-card span:not(.cc-icon):not(.cc-social){font-weight:800}
+.cc-social{display:flex;gap:var(--sp-3)}
+.contact-promise{background:var(--amber-100);border-radius:var(--r-md);padding:var(--sp-4);font-weight:700;font-size:.875rem;color:var(--amber-950);margin:0}
+.form{display:grid;gap:var(--sp-4);background:var(--surface);border:1px solid var(--border);border-radius:var(--r-lg);padding:var(--sp-6)}
+.field{display:grid;gap:6px}
+.field label{font-weight:800;font-size:.875rem}
+.req{color:var(--danger)}
+.field input,.field select,.field textarea{min-height:48px;border:1.5px solid var(--border-strong);border-radius:var(--r-sm);padding:10px var(--sp-4);font:inherit;background:var(--surface);color:var(--text);width:100%}
+.field textarea{min-height:120px;resize:vertical}
+.field input:focus,.field select:focus,.field textarea:focus{border-color:var(--green-600);outline:3px solid color-mix(in srgb,var(--focus) 30%,transparent);outline-offset:0}
+.field-row{display:grid;gap:var(--sp-4)}
+@media (min-width:640px){.field-row{grid-template-columns:1fr 1fr}}
+.field-check{grid-template-columns:auto 1fr;align-items:start;display:grid}
+.field-check input{width:24px;height:24px;min-height:24px;margin-block-start:2px}
+.field-check label{font-weight:600;font-size:.875rem;color:var(--text-muted)}
+.hp-field{position:absolute!important;inset-inline-start:-9999px;width:1px;height:1px;opacity:0}
+.form-error{background:#fdecea;color:var(--danger);border:1px solid var(--leaf-600);border-radius:var(--r-sm);padding:var(--sp-3);font-weight:700;font-size:.875rem}
+.form-ok{background:var(--green-50);color:var(--green-800);border:1px solid var(--green-600);border-radius:var(--r-sm);padding:var(--sp-4)}
+.form-ok[hidden],.form-error[hidden]{display:none}
+.field.is-invalid input,.field.is-invalid textarea,.field.is-invalid select{border-color:var(--danger)}
+.field .err{color:var(--danger);font-size:.75rem;font-weight:800}
+@media (min-width:1024px){.contact-grid{grid-template-columns:4fr 7fr}}
+
+/* post */
+.progress-bar{position:fixed;inset-inline-start:0;top:0;height:3px;background:var(--amber-400);width:0;z-index:120}
+.post-meta{color:var(--text-muted);font-size:.875rem;font-weight:700}
+.post-cover{border-radius:var(--r-lg);overflow:hidden;position:relative;aspect-ratio:16/9;margin-block-end:var(--sp-6)}
+.post-cover picture,.post-cover img{position:absolute;inset:0}
+.prose{font-size:1.0625rem;line-height:1.75}
+html[lang="ar"] .prose{line-height:2}
+.prose h2{margin-block:1.4em .6em;font-size:1.375rem}
+.prose h3{margin-block:1.2em .5em}
