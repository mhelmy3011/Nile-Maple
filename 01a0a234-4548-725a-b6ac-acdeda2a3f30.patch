+.prose th,.prose td{border:1px solid var(--border);padding:10px 12px;text-align:start}
+.prose th{background:var(--surface-2)}
+.prose img{border-radius:var(--r-md)}
+.share-row{display:flex;gap:var(--sp-2);align-items:center;flex-wrap:wrap;margin-block-start:var(--sp-8);padding-block-start:var(--sp-4);border-block-start:1px solid var(--border)}
+
+/* tables (static pages) */
+.table-wrap{overflow-x:auto;border:1px solid var(--border);border-radius:var(--r-md);margin-block:var(--sp-4)}
+.table-wrap table{width:100%;border-collapse:collapse;font-size:.875rem;min-width:560px}
+.table-wrap th,.table-wrap td{padding:10px 14px;border-block-end:1px solid var(--border);text-align:start}
