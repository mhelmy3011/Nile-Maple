+++ b/assets/src/app.css
@@ -0,0 +1,481 @@
+/* Nile-Maple design system — mobile-first, logical properties only (doc 02/03).
+   Tokens: doc 02 §2-3. No physical left/right in layout rules. */
+:root{
+  --green-50:#eafbf1;--green-100:#d0f6de;--green-200:#a4edc0;--green-300:#6fdf9c;--green-400:#3ecb77;
+  --green-500:#1dbf5a;--green-600:#12a24a;--green-700:#0e8140;--green-800:#0d6636;--green-900:#0b542e;--green-950:#052e19;
+  --amber-50:#fff8e6;--amber-100:#ffedc2;--amber-200:#ffdd85;--amber-300:#fdca47;--amber-400:#fcb929;--amber-600:#d18a06;--amber-950:#3f2306;
+  --pine-50:#f0f6f2;--pine-100:#dcebe1;--pine-300:#90bba2;--pine-600:#448262;--pine-800:#1f4434;--pine-900:#16382b;--pine-950:#0b2018;
+  --leaf-600:#b02718;
+  --n-50:#f7f9f7;--n-100:#eef2ee;--n-200:#dde4dd;--n-300:#c2ccc2;--n-500:#6d7d6f;--n-600:#556457;--n-800:#323d33;--n-900:#222b24;--n-950:#131a15;
+  --surface:#fff;--surface-2:var(--n-50);--surface-3:var(--green-50);--surface-inverse:var(--pine-900);
+  --text:var(--green-950);--text-muted:var(--n-600);--text-inverse:#fff;
+  --border:var(--n-200);--border-strong:var(--n-300);
+  --action:var(--green-500);--action-hover:var(--green-600);--action-text:var(--green-950);
+  --signal:var(--amber-400);--signal-text:var(--green-950);
+  --focus:var(--green-600);--danger:var(--leaf-600);
+  --e1:0 1px 2px rgba(11,32,24,.06),0 2px 8px rgba(11,32,24,.06);
+  --e2:0 1px 2px rgba(11,32,24,.06),0 12px 28px rgba(11,32,24,.10);
+  --e3:0 24px 64px rgba(11,32,24,.18);
+  --r-sm:10px;--r-md:14px;--r-lg:20px;--r-pill:999px;
+  --sp-1:4px;--sp-2:8px;--sp-3:12px;--sp-4:16px;--sp-5:20px;--sp-6:24px;--sp-8:32px;--sp-10:40px;--sp-12:48px;--sp-16:64px;--sp-20:80px;--sp-24:96px;
+  --font-sans:"Nunito","Nunito Fallback",system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
+  --font-ar:"Tajawal","Tajawal Fallback",system-ui,"Segoe UI",sans-serif;
+  --header-h:56px;--topbar-h:40px;--cb-h:64px;
+  --ease:cubic-bezier(.2,.7,.2,1);
+}
+html[lang="ar"]{--font-sans:var(--font-ar)}
