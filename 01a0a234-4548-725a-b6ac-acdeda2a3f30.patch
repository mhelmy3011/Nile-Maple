+.table-wrap tbody th[scope=row],.table-wrap td:first-child{position:sticky;inset-inline-start:0;background:var(--surface);font-weight:800}
+.table-legend{font-size:.8125rem}
+
+/* cta band */
+.cta-band{background:var(--green-500);color:var(--green-950)}
+.cta-inner{display:grid;gap:var(--sp-6);padding-block:var(--sp-12)}
+.cta-inner h2{color:var(--green-950)}
+.cta-inner p{margin:0;font-weight:600}
+.cta-actions{display:grid;gap:var(--sp-3)}
+@media (min-width:768px){.cta-inner{grid-template-columns:1fr auto;align-items:center}.cta-actions{display:flex}}
+
+/* footer */
+.footer{background:var(--pine-900);color:#fff;padding-block:var(--sp-12) var(--sp-6)}
+.footer-grid{display:grid;gap:var(--sp-8)}
+.footer-brand img{width:190px;height:54px;margin-block-end:var(--sp-4)}
+.footer-brand p{color:var(--pine-300);max-width:36ch}
+.footer-social{display:flex;gap:var(--sp-2)}
+.footer-social a{width:44px;height:44px;border-radius:50%;background:rgba(255,255,255,.1);color:#fff;display:inline-flex;align-items:center;justify-content:center}
+.footer-social a:hover{background:var(--amber-400);color:var(--pine-950)}
+.footer h2{font-size:.8125rem;text-transform:uppercase;letter-spacing:.08em;color:var(--amber-400);margin-bottom:var(--sp-4)}
+html[lang="ar"] .footer h2{text-transform:none;letter-spacing:0}
+.footer ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}
+.footer ul a{color:var(--pine-100);text-decoration:none;font-size:.9375rem}
+.footer ul a:hover{color:var(--amber-400)}
+.footer .cnt{font-size:.6875rem;background:rgba(255,255,255,.14);border-radius:var(--r-pill);padding:1px 8px;margin-inline-start:6px}
+.f-row{display:flex;gap:10px;align-items:center;color:#fff;text-decoration:none;min-height:44px;font-size:.9375rem}
+.f-row .i{width:18px;height:18px;color:var(--amber-400)}
+.f-row:hover{color:var(--amber-400)}
+.f-addr{color:var(--pine-300);font-size:.875rem;display:flex;gap:8px}
+.footer-contact{display:grid;gap:6px;justify-items:start}
+.footer-legal{margin-block-start:var(--sp-10);padding-block-start:var(--sp-4);border-block-start:1px solid rgba(255,255,255,.14);display:flex;flex-wrap:wrap;gap:var(--sp-4);align-items:center;justify-content:space-between;font-size:.8125rem;color:var(--pine-300)}
+.legal-links{display:flex;gap:var(--sp-4);align-items:center}
+.legal-links a{color:var(--pine-300)}
+@media (min-width:768px){.footer-grid{grid-template-columns:1fr 1fr}}
+@media (min-width:1024px){.footer-grid{grid-template-columns:2fr 1fr 1fr 1.4fr}}
+
+/* 404 */
+.nf{text-align:center;padding-block:var(--sp-20)}
+.nf-code{font-size:clamp(4rem,20vw,7rem);font-weight:800;color:var(--green-200)}
+.nf-actions{display:flex;gap:var(--sp-3);justify-content:center;flex-wrap:wrap;margin-block:var(--sp-6)}
+.nf-cats{justify-content:center;text-align:start}
+
+/* reveals & motion */
+.js .reveal{opacity:0;transform:translateY(8px);transition:opacity .32s var(--ease),transform .32s var(--ease)}
+.js .reveal.is-in{opacity:1;transform:none}
+@media (min-width:640px){.js [data-stagger] > *{transition-delay:calc(var(--i,0) * 60ms)}}
+@media (prefers-reduced-motion:reduce){
+  *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
+  .js .reveal{opacity:1;transform:none}
+}
