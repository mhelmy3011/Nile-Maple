+<?php
+namespace Nm;
+
+/** Public route table (doc 05 §1). Returns [template, params, pathForCanonical]. */
+final class Routes
+{
+    public static function match(string $path): ?array
+    {
+        $path = trim($path, '/');
+        $segs = $path === '' ? [] : explode('/', $path);
+        $m = static function (int $n) use ($segs) { return count($segs) === $n; };
+        $g = static function (int $i) use ($segs) { return $segs[$i] ?? ''; };
+        if ($m(0)) return ['pages/home', [], ''];
+        if ($m(1) && $g(0) === 'about') return ['pages/about', [], 'about'];
+        if ($m(1) && $g(0) === 'services') return ['pages/services', [], 'services'];
+        if ($m(2) && $g(0) === 'services') return ['pages/service', ['slug' => $g(1)], "services/{$g(1)}"];
+        if ($m(1) && $g(0) === 'categories') return ['pages/categories', [], 'categories'];
+        if ($m(2) && $g(0) === 'categories') return ['pages/category', ['slug' => $g(1)], "categories/{$g(1)}"];
+        if ($m(2) && $g(0) === 'products') return ['pages/product', ['slug' => $g(1)], "products/{$g(1)}"];
+        if ($m(1) && $g(0) === 'blog') return ['pages/blog', [], 'blog'];
+        if ($m(2) && $g(0) === 'blog') return ['pages/post', ['slug' => $g(1)], "blog/{$g(1)}"];
+        if ($m(1) && $g(0) === 'contact') return ['pages/contact', [], 'contact'];
+        if ($m(1) && $g(0) === 'faq') return ['pages/faq', [], 'faq'];
+        foreach (['quality-handling', 'packaging-logistics', 'seasonal-availability', 'export-documentation', 'privacy', 'terms'] as $s) {
+            if ($m(1) && $g(0) === $s) return ['pages/static-block', ['zone' => $s], $s];
+        }
+        return null;
+    }
+}
