# --- secrets & runtime state (live above the webroot on Hostinger, never in git) ---
config/config.php
cache/
storage/
releases/
dist/

# --- extracted source media: regenerate with  python3 tools/extract_content.py --media ---
docs/data/media/

# --- build output. public_html is generated from the DB, so only the four shipped
#     entry points are tracked; the language trees, sitemaps, assets and media are not. ---
/public_html/*
!/public_html/index.php
!/public_html/.htaccess
!/public_html/.user.ini
!/public_html/manage/
/public_html/manage/*
!/public_html/manage/index.php
!/public_html/instructor/
/public_html/instructor/*
!/public_html/instructor/index.php

# --- dev-only tooling: the WASM runtime install is local; the shim is tracked ---
node_modules/
tools/harness/node_modules/
*.log
!docs/instructor-verification.log

# --- Playwright: browsers cache elsewhere (~/Library/Caches/ms-playwright); reports/traces are
#     per-run output. RTL visual baselines (tests/*-snapshots/) ARE tracked — committed on purpose. ---
tools/test/browser/test-results/
tools/test/browser/playwright-report/
tools/test/browser/blob-report/

# --- editor / OS noise ---
.env
.DS_Store
Thumbs.db
.idea/
.vscode/
